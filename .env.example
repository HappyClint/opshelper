# scripts/opshelper.py init 自动生成本机路径、身份和随机密码；此文件仅为参数说明。
COMPOSE_PROJECT_NAME=opshelper
# 密码使用 URL 安全字符 A-Z a-z 0-9 _ -；初始化工具会生成。
POSTGRES_PASSWORD=
# 仅空库首次初始化使用，不会重置现有管理员，也不会创建演示用户。
OPSHELPER_ADMIN_PASSWORD=
OPSHELPER_API_IMAGE=opshelper-api:local
OPSHELPER_WORKER_IMAGE=opshelper-worker:local
OPSHELPER_WEB_IMAGE=opshelper-web:local
OPENCODE_DOCKER_IMAGE=opshelper/opencode-runtime:1.18.34
OPSHELPER_POSTGRES_IMAGE=postgres:16
OPSHELPER_NGINX_IMAGE=nginx:alpine
OPSHELPER_HTTP_HOST=127.0.0.1

# 必填：改成当前部署 data 目录的宿主机绝对路径。Docker 用它创建 PostgreSQL
# 和每用户 bind mount；这里始终是宿主机路径，/data 只是 API 容器内视图。
DATA_ROOT_HOST=/absolute/path/to/opshelper/data

# API、worker 和每个 OpenCode runtime 使用同一宿主身份，使 API 准备的用户目录
# 可直接读写，并可读取受管配置，不依赖启动后提权修复所有权。
OPSHELPER_UID=1000
OPSHELPER_GID=1000
OPSHELPER_DOCKER_GID=989

# 本机 HTTP 入口；默认只监听本机回环地址。
OPSHELPER_HTTP_PORT=8080
# API 容器内部监听地址；本机独立调试可改为 127.0.0.1。
OPSHELPER_API_HOST=0.0.0.0

# 会话与生命周期策略。
OPSHELPER_SESSION_COOKIE_NAME=opshelper_session
OPSHELPER_SESSION_TTL_HOURS=168
OPSHELPER_IDLE_TIMEOUT_MINUTES=60
OPSHELPER_CHAT_UPLOAD_TTL_HOURS=168
OPSHELPER_SCHEDULE_POLL_MS=15000
# 计划时间超过该毫秒数才记为停机漏点，避免正常轮询延迟被误判。
OPSHELPER_SCHEDULE_LATE_GRACE_MS=120000

# 每用户 runtime 限额。
OPENCODE_RUNTIME_MEMORY_MB=2048
OPENCODE_RUNTIME_CPUS=2
OPSHELPER_EXECUTION_POLL_MS=1000
# 单次顶层执行从实际开始计算的总时限，包含等待用户回答的时间。
OPSHELPER_EXECUTION_TIMEOUT_MINUTES=30
OPSHELPER_INTERACTION_TIMEOUT_MINUTES=30
